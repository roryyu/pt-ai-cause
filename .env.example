# ============================================================
# 归因模块 - 环境变量模板
# 复制为 .env 并按环境填写；变量说明见 lib/env.ts 中的 Zod Schema
# ============================================================

# ---------- 应用 ----------
# 运行环境：development / staging / production
APP_ENV=development
# 3100 端口：3000 已被 Access realm 注册的 Creative 客户端占用
APP_URL=http://localhost:3100
# 会话签名密钥（生产环境必须替换，至少 32 字符）
AUTH_SECRET=

# ---------- PT AI Access 统一认证（OIDC BFF，见 doc/鉴权接入PT-AI-Access设计.md） ----------
# 使用共享 pt-ai Realm；生产 https://identity.pmdevops.com/realms/pt-ai。
# 浏览器 issuer 与 ID Token iss 必须一致；容器 discovery 可单独设置 OIDC_INTERNAL_ISSUER。
OIDC_ISSUER=http://localhost:8094/realms/pt-ai
# Access realm 为 cause 注册的客户端凭据（生产环境由 Access 管理员分配）

#OIDC_INTERNAL_ISSUER=http://identity:8080/realms/pt-ai
OIDC_CLIENT_ID=pt-ai-cause
OIDC_CLIENT_SECRET=
# access-app 容器内部接口基址与共享密钥（x-pt-access-internal-secret）
ACCESS_INTERNAL_BASE_URL=http://localhost:4300
ACCESS_INTERNAL_SECRET=
# cause 在 Access entryCatalog 中的入口 ID
ACCESS_ENTRY_ID=cause
# principal 请求期缓存秒数（fail-closed，缺省 60）
#ACCESS_PRINCIPAL_CACHE_SECONDS=60

# 分层会话模式与已部署平台一致；不要单独从 legacy 切到 enforce。
SESSION_POLICY_V1_MODE=legacy
SESSION_IDLE_SECONDS=36000
SESSION_MAX_SECONDS=86400
SESSION_REMEMBER_IDLE_SECONDS=2592000
SESSION_REMEMBER_MAX_SECONDS=7776000
# enforce 必须由平台分配受限 status 客户端，不能使用人员客户端或管理员凭据。
#IDENTITY_SESSION_CLIENT_ID=pt-ai-session-status-cause
#IDENTITY_SESSION_CLIENT_SECRET=

# ---------- 统一模型网关（所有 AI 调用必须经过，见 design.md 1.3 / 12.1） ----------
MODEL_GATEWAY_BASE_URL=http://localhost:8080/openai/v1
# 由 Foundation 分配 Cause Agent Token；不使用供应商直连密钥。
MODEL_GATEWAY_API_KEY=
MODEL_GATEWAY_DEFAULT_MODEL=openai/gpt-5.6-sol
# 正式环境以 Foundation Models/Agent 授权清单确认上述别名指向 Sol、允许 Responses 流式。
# 推理强度固定 low；不自动回退 Luna、不自动重试付费请求。
MODEL_GATEWAY_TIMEOUT_MS=120000

# ---------- PostgreSQL + pgvector（主存储，见 design.md 6.1） ----------
# Prisma 7 统一连接串：CLI（prisma.config.ts 的 migrate/db push/studio）
# 与运行时驱动适配器（lib/db/index.ts 的 @prisma/adapter-pg）共用；
# ?schema= 参数须与 prisma/schema.prisma 的 datasource.schemas 保持一致
DATABASE_URL=postgresql://user:password@localhost:5432/postgres?schema=cause

# ---------- Redis（会话缓存/限流/任务状态锁，见 design.md 6.3） ----------
REDIS_URL=redis://localhost:6379

# ---------- 消息队列（研究任务队列，预留，见 design.md 6.3） ----------
MQ_URL=amqp://localhost:5672

# ---------- MCP Gateway（OAuth2.1，见 design.md 5.1.3） ----------
MCP_GATEWAY_URL=
MCP_GATEWAY_CLIENT_ID=
MCP_GATEWAY_CLIENT_SECRET=

# ---------- Web 抓取 Firecrawl（见 design.md 5.1.4） ----------
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# ---------- 对象存储（S3 兼容 / MinIO，见 design.md 6.3） ----------
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=insight

# ---------- Adjust 报告服务 API（见 doc/Adjust官网API与MCP对接指南-20260902.md） ----------
# API 识别码：Adjust 控制面板 → 账户设置 → 个人档案 获取，Bearer Token 认证
ADJUST_API_TOKEN=
ADJUST_RS_API_BASE_URL=https://automate.adjust.com/reports-service
# 报告时区：同步落库与算子 API 直查统一口径（缺省 +08:00；格式 ±HH:MM）
# 注意：变更时区后历史已同步数据口径不同，建议重跑一次较大窗口的同步（如 --days 30）
ADJUST_RS_UTC_OFFSET=+08:00
# Adjust 查询缓存开关（true/false，默认 false）：关闭时 Adjust API 直查不读不写本地查询缓存，每次实时请求上游；
# 开启后按 date_period 推断 TTL（历史区间 7 天 / 含近日 30 分钟），GA4 / Google Ads 缓存不受此开关影响
ADJUST_QUERY_CACHE_ENABLED=false
# 定时同步：无常驻定时器，由外部 cron 驱动（Adjust 数据 T+1，幂等可重跑）：
#   30 9 * * * curl -X POST http://localhost:3000/api/v1/syncs/adjust -d '{"days":3}'
# 手动：npx tsx scripts/sync-adjust-data.ts [--days N]

# ---------- Google Analytics 4（GA4，官方 @google-analytics/data SDK） ----------
# 服务账号方式：将 Google Cloud 下载的完整 service_account JSON 保存到项目内 .secrets/ 目录。
# JSON 中的 project_id、client_email、private_key 等字段由 SDK 自动读取，不必拆成环境变量。
# 保留原始 JSON 格式与 private_key 中的 \n 转义；本变量填写文件绝对路径，不是 JSON 内容。
# .secrets/ 已由 Git/Docker 忽略，发布清单也不收录；不要将凭证放到项目目录之外。
# 本机示例（替换为项目的实际绝对路径，不使用 ~）：
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/pt-ai-cause/.secrets/ga4-service-account.json"
# 容器示例：GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/ga4-service-account.json
# 将项目内 .secrets/ga4-service-account.json 只读挂载到上述容器路径；宿主机路径不能直接当容器内路径。
# 凭证文件仅允许运行服务的账号读取（如权限 600），不要提交仓库、打包进镜像或上传到前端。
# 私钥若已公开或发到聊天中，先在 Google Cloud 撤销对应密钥，再下载新的 JSON。
# 使用工作负载身份等其他 ADC 来源时可不设置此变量。
GOOGLE_APPLICATION_CREDENTIALS=
# 应用与 MCP 若分别运行，两个进程都需要加载此变量并能读取文件（容器需分别挂载）。
# 修改配置或轮换凭证后重启应用及 MCP 进程，使 SDK 重新加载认证；不是重启数据库。
# Google Cloud 项目需启用 Google Analytics Data API；GA4 属性访问管理中，
# 将 JSON 的 client_email 添加为查看者（Viewer）或更高权限；仅 Cloud IAM 权限不够。
# 页面：数据源管理 → 注册数据源 → API → Google Analytics 4，填写数字 Property ID。
# Property ID 不在服务账号 JSON 中，不是 project_id、client_id 或 G- 开头的 Measurement ID。
# Property ID 在 GA4 管理 → 属性详情中获取，保存数据源后点击测试连接。
# GA4 走报告直查与短缓存，不写入 Adjust 明细库；去重用户数与比率不二次求和。

# ---------- Google Ads（官方 google-auth-library + Google Ads REST v26） ----------
# 复用上面的 GOOGLE_APPLICATION_CREDENTIALS；无需另存 JSON，也无需 GA4 Property ID。
# 数据源管理 → 注册数据源 → API → Google Ads → 发现账户 → 选择投放客户并保存。
# Cloud 项目启用 API：https://console.cloud.google.com/apis/library/googleads.googleapis.com
# API 访问等级：https://console.cloud.google.com/google/ads-apis/overview
# Test access 只适用于官方测试账户；真实投放账户需要对应生产访问资格。
# Developer token 已于 2026-09-09 退役，新接入按 Cloud project 访问等级授权。
# Google Ads → 管理 → 访问权限和安全 → 用户：给 JSON 中 client_email 添加只读权限。
# 经理账户访问子账户时保存客户 ID 与经理 ID（均为去掉连字符的10位数字）。
# 安装量使用单一安装/首次打开转化动作，不能将所有转化或 Adjust 安装混为下载量。
# Web 与 MCP ask 共用此数据源及 ADC；仅只读查询，不改广告状态、预算或云端权限。

# ---------- MCP 服务（npm run mcp，见 doc/mcp-service.md） ----------
# 把任务问答与深度研究作为 MCP 工具对外提供（streamable-http），供 dsh-cause 插件调用。
# 专用 API Key 鉴权（Bearer），不依赖浏览器登录；缺失或少于 32 字符时服务拒绝启动。
# 生成：openssl rand -hex 32；调用方（dsh-stack 的 CAUSE_MCP_TOKEN）填同一个值。
CAUSE_MCP_API_KEY=
# 监听地址与端口（默认只监听本机；3100 已被 Next.js 应用占用）
CAUSE_MCP_HOST=127.0.0.1
CAUSE_MCP_PORT=3101
# MCP 调用落库使用的服务用户（首次调用自动创建；与浏览器登录用户隔离）
CAUSE_MCP_ACTOR_ID=user_mcp_service
CAUSE_MCP_ACTOR_NAME=MCP 服务
CAUSE_MCP_ACTOR_EMAIL=mcp-service@cause.local
# 单个 HTTP 请求超时（毫秒）：深度研究最长约 10 分钟，默认 15 分钟
CAUSE_MCP_REQUEST_TIMEOUT_MS=900000
# Next.js 把公网 /mcp 反代到 MCP 服务的目标（next.config.ts rewrites）。
# 生产默认 http://mcp:3101/mcp（docker 服务名 mcp，需与 app 同网络且 CAUSE_MCP_HOST=0.0.0.0）；
# 本地联调可改为 http://127.0.0.1:3101/mcp。设了它，dsh 侧 CAUSE_MCP_URL 即可用 https://<域名>/mcp。
CAUSE_MCP_PROXY_TARGET=http://mcp:3101/mcp
